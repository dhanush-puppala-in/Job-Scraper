# Server Config
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/acdyon-jobs
DB_NAME=acdyon-jobs

# Scraper Config
SCRAPER_DELAY_MIN=2000
SCRAPER_DELAY_MAX=5000
SCRAPER_TIMEOUT=30000
MAX_RETRIES=3

# Proxy (optional)
PROXY_LIST=
USE_PROXY=false

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_HOUR=100

# Logging
LOG_LEVEL=debug

# Job Sources (enable/disable specific sources)
ENABLE_JOB_SCRAPER_API=true
ENABLE_FALLBACK_MODE=true

# Session Management
SESSION_COOKIE_NAME=scraper_session
SESSION_DURATION_HOURS=24
